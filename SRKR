local isOpening = false
local function toggleUI()
	if isOpening then return end
	isOpening = true

	if not frame.Visible then
		frame.Visible = true
		frame.Size = UDim2.new(0, 0, 0, 0)
		frame.Position = UDim2.new(0.5, 0, 0.5, 0)
		frame.BackgroundTransparency = 0
		
		local openTween = TweenService:Create(frame, tweenInfo, {
			Size = UDim2.new(0, 300, 0, 280),
			Position = UDim2.new(0.5, -150, 0.5, -140)
		})
		openTween:Play()
		openTween.Completed:Wait()
	else
		local closeTween = TweenService:Create(frame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, 0, 0, 0),
			Position = UDim2.new(0.5, 0, 0.5, 0)
		})
		closeTween:Play()
		closeTween.Completed:Wait()
		frame.Visible = false
	end
	
	isOpening = false
end

float.MouseButton1Click:Connect(toggleUI)

